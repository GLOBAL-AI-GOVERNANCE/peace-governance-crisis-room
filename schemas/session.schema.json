{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global-ai-governance.github.io/peace-os-crisis-room/schemas/session.schema.json",
  "title": "Peace OS Local Browser Session",
  "type": "object",
  "additionalProperties": false,
  "required": ["session_schema_version", "app_version", "session_id", "started_at", "screen", "mode", "scenario_id", "scenario_version", "card_id", "reviewed", "marks", "confidence", "corroboration", "authenticity", "release_id", "actions", "remaining_minutes", "public_pressure", "timed", "human_confirmation", "confirmed_digest", "committed", "result", "audit_events"],
  "properties": {
    "session_schema_version": {"const": "2.0"},
    "app_version": {"const": "0.3.0-rc2"},
    "session_id": {"type": "string", "minLength": 8},
    "started_at": {"type": "string", "format": "date-time"},
    "screen": {"enum": ["resume", "start", "boundary", "briefing", "evidence", "card", "confidence", "corroboration", "authenticity", "release", "actions", "review", "result", "delete_confirm"]},
    "mode": {"enum": ["", "practice", "assessment", "facilitator"]},
    "scenario_id": {"type": "string"},
    "scenario_version": {"type": "string"},
    "card_id": {"type": "string"},
    "reviewed": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "marks": {"type": "object"},
    "confidence": {"enum": ["", "Confirmed", "Likely", "Possible", "Unverified"]},
    "corroboration": {"enum": ["", "Corroborated", "Partially corroborated", "Contradictory", "Uncorroborated"]},
    "authenticity": {"enum": ["", "No indicators identified", "Manipulation suspected", "Authenticity unclear", "Not applicable"]},
    "release_id": {"type": "string"},
    "actions": {"type": "object"},
    "remaining_minutes": {"type": "integer", "minimum": 0},
    "public_pressure": {"type": "integer", "minimum": 0, "maximum": 100},
    "timed": {"type": "object"},
    "human_confirmation": {"type": "boolean"},
    "confirmed_digest": {"type": "string"},
    "committed": {"type": "boolean"},
    "result": {"type": ["object", "null"]},
    "audit_events": {"type": "array"}
  }
}
