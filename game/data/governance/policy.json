  "require_action_budget": true,
  "require_complete_evidence_review": true,
  "require_decision_digest_confirmation": true,
  "require_final_review_screen": true,
  "require_human_final_confirmation": true,
  "require_in_memory_audit_chain": true,
  "require_separated_experience_modes": true,
  "required_score_components": {
    "actions": 15,
    "authenticity": 10,
    "confidence": 15,
    "corroboration": 10,
    "evidence_marking": 20,
    "evidence_review": 10,
    "release": 15,
    "timeliness": 5
  },
  "schema_version": "1.1",
  "simulation_only": true
}
